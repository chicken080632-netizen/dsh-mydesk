{
  "name": "dsh-mydesk",
  "version": "2.8.0",
  "description": "dsh-media-desk v2.7.2 的私人副本（改名 dsh-mydesk），用于二次开发：与原插件并排共存、独立数据目录。一句话记灵感，一键成稿：口播脚本、标题、视频封面、配图和黑白线稿分镜。",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-media-desk",
    "content"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicken080632-netizen/dsh-mydesk.git"
  },
  "homepage": "https://github.com/chicken080632-netizen/dsh-mydesk#readme",
  "bugs": {
    "url": "https://github.com/chicken080632-netizen/dsh-mydesk/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js",
    "assets": "python3 scripts/gen-assets.py"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
